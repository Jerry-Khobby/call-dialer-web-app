# Copy to .env and fill in. Everything here is free to run.

# Local MongoDB Community Server, or a free MongoDB Atlas (M0) connection string.
MONGODB_URI=mongodb://localhost:27017/call-dialer

# Any long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start with this example value.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

PORT=3000

# Origins allowed to call the API (comma-separated). The Angular dev server by default.
CLIENT_ORIGIN=http://localhost:4200

# How many proxies sit in front of the API. Set to 1 on hosts like Render or Railway, so
# rate limits see each visitor's real IP instead of the proxy's. Leave false locally.
TRUST_PROXY=false

# Optional TURN relay for callers behind strict firewalls/NATs (e.g. a self-hosted coturn).
# Leave empty to use only Google's free public STUN servers.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
